# Evolve-Agent environment template.
# Copy to ../.env (the CVDP repo root) and fill in.

# Required: API key for the OpenAI-compatible Qwen endpoint.
# Either var name works; QWEN_API_KEY is preferred.
QWEN_API_KEY=your_dashscope_or_local_api_key

# Endpoint. Default points at Alibaba DashScope's OpenAI-compatible URL.
# For self-hosted vLLM use e.g. http://localhost:8000/v1
# For Ollama use http://localhost:11434/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Backing model id. Examples:
#   qwen3-max
#   qwen3-coder-plus
#   qwen3-235b-a22b
#   qwen3-32b   (vLLM/Ollama)
QWEN_MODEL=qwen3-max

# Sampling and budget knobs.
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=4096

# Number of critic+repair rounds inside the qwen3-evolve wrapper.
QWEN_EVOLVE_PASSES=2

# Used by the Docker agent only (in-container lint+repair passes).
EVOLVE_MAX_PASSES=3

# Pass through to CVDP harness the same way other model factories do.
CUSTOM_MODEL_FACTORY=evolve_agent/qwen_factory.py
